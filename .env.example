APP_ENV=local
APP_DEBUG=true
APP_URL=https://cfc-abudhabi.test

KIRBY_PANEL_INSTALL=false
KIRBY_CACHE_PAGES=false

# Panel sign-in through CfC SSO. Existing Kirby users are the allowlist; the client is
# "cfc-abudhabi-live" in the admin app, redirect URI ${APP_URL}/oauth/login/cfc.
CFC_SSO_ENABLED=false
CFC_SSO_ISSUER=https://cfc-internal.test
CFC_SSO_CLIENT_ID=
CFC_SSO_CLIENT_SECRET=
CFC_SSO_ONLY=true

STRIPE_SECRET_KEY_TEST=
STRIPE_PUBLIC_KEY_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_PUBLIC_KEY_LIVE=

# Production uses Mailgun. Local and staging must use Mailpit (the site refuses to
# start otherwise), so every custom and Kirby-generated email stays in its inbox.
MAIL_MAILER=mailpit
MAILGUN_API_KEY=
MAILGUN_DOMAIN=reservations.crypto-finance-conference.com
MAILGUN_MAILER_DOMAIN=mailer.cfc-stmoritz.com
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1025
MAILPIT_USERNAME=
MAILPIT_PASSWORD=

# The newsletter form subscribes to this list for real, in every environment.
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=a7fa7a784c

MAIL_FROM_NAME="CfC St. Moritz Abu Dhabi"
MAIL_FROM_ADDRESS=noreply@reservations.crypto-finance-conference.com
MAILER_FROM_ADDRESS=noreply@mailer.cfc-stmoritz.com

# Disable all form emails, or redirect every form email to one recipient.
FORM_EMAIL_ENABLED=true
FORM_EMAIL_OVERRIDE_TO=
